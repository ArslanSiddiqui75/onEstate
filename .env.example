# Fallback region when the host is not 0nestreet.co.uk or 0nestreet.com.
# onestreet-uk → 0nestreet.co.uk
# onestreet-us → 0nestreet.com
# Older certified-uk and certified-us values still resolve to the same setups.
NEXT_PUBLIC_BRAND=onestreet-uk

# Legacy file inboxes (bookings, repair reports) for local demos without Supabase.
# With Supabase configured, diary/booking/portals/lettings persist in the database
# and this flag is unused. Production without Supabase keeps them closed.
DEMO_PUBLIC_INBOX=

# Supabase (required for production). Apply every file in supabase/migrations/,
# including 20261029010000_agency_and_lettings_books.sql for diary + lettings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Platform Stripe (operator-owned). Tenants only add a card at Checkout —
# they never provide Stripe keys or Connect accounts.
# UK and US are separate Stripe accounts. A shared STRIPE_SECRET_KEY is ignored.
# Real-time billing needs BOTH of these once Supabase is configured above:
#  1. Apply supabase/migrations/007_billing.sql (adds subscription lifecycle
#     columns to organizations and locks them so only this webhook, running
#     as the service role, can ever change a tenant's plan/status).
#  2. In each Stripe Dashboard, point a webhook at that region's URL:
#     UK  {NEXT_PUBLIC_APP_URL}/api/stripe/webhook/uk
#     US  {NEXT_PUBLIC_APP_URL}/api/stripe/webhook/us
#     Events: checkout.session.completed,
#     customer.subscription.created/updated/deleted/trial_will_end,
#     invoice.paid, invoice.payment_failed.
#     The legacy URL /api/stripe/webhook tries the UK secret, then the US one.
# Without that region's keys, Checkout/Portal fall back to a local demo mode
# that just previews plan access — no card is ever charged.
STRIPE_SECRET_KEY_UK=
STRIPE_WEBHOOK_SECRET_UK=
STRIPE_SECRET_KEY_US=
STRIPE_WEBHOOK_SECRET_US=
# Price ids belong to the account above. They are not shared across regions.
STRIPE_PRICE_SOLO_UK=
STRIPE_PRICE_TEAM_UK=
STRIPE_PRICE_ENTERPRISE_UK=
STRIPE_PRICE_SOLO_US=
STRIPE_PRICE_TEAM_US=
STRIPE_PRICE_ENTERPRISE_US=

# Twilio (optional — SMS sends simulate without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public origin Twilio POSTs to (must match the webhook URL in the Twilio console).
# Defaults to NEXT_PUBLIC_APP_URL. Example: https://on-estate.vercel.app
# TWILIO_WEBHOOK_BASE_URL=
# auto = Twilio when configured, else simulated | simulated = never call Twilio | twilio = always Twilio
MESSAGING_MODE=auto

# Conversation email sends from the domain connected in Settings → Email domain.
# The brokerage adds a mail CNAME, a DKIM CNAME, and an SPF TXT for MAIL_HOST.
# Delivery uses SMTP. It does not use Resend.
MAIL_HOST=mail.onestreet.app
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Resend remains only for team invites and e-sign, not Conversations.
EMAIL_MODE=auto
RESEND_API_KEY=
EMAIL_FROM=
# Inbound email (optional). Resend Receiving + webhook:
#   1. Enable receiving on a .resend.app subdomain or custom domain (MX).
#   2. Webhook URL: {NEXT_PUBLIC_APP_URL}/api/email/webhook/inbound
#      Event: email.received. Signing secret → RESEND_WEBHOOK_SECRET (whsec_…).
#   3. EMAIL_INBOUND_ADDRESS is any address on that receiving domain. Outbound
#      sets Reply-To to address+{leadId}@domain so replies match the lead even
#      if From does not. Without these, CRM → Simulate inbound still works.
# RESEND_WEBHOOK_SECRET=
# EMAIL_INBOUND_ADDRESS=inbox@your-subdomain.resend.app

# E-sign (Transactions). Simulated signature links at /sign/{token} by default.
# Optional later: DROPBOX_SIGN_API_KEY for live provider behind the same API.
ESIGN_MODE=auto
# DROPBOX_SIGN_API_KEY=

# CRM automations (migration 010_automation_runs.sql). Workflows execute
# server-side: triggers run inline on lead create / stage change, but `wait`
# steps only resume when something hits /api/automations/cron/run. Point an
# external scheduler (cron-job.org) there every few minutes with an
# X-Cron-Secret header. Falls back to SOCIAL_CRON_SECRET / CRON_SECRET when unset.
# Opening the CRM also flushes this org's due steps as a hosting-plan fallback.
# Required in production. Cron routes return 401 if none of these are set.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when CRON_SECRET is set.
AUTOMATION_CRON_SECRET=

# Platform admin console: /admin
# Required in production. Passwords are checked only on the server
# (POST /api/admin/login) — they are not shipped to the browser.
PLATFORM_ADMIN_PASSWORD=
# Optional dedicated cookie-signing secret (falls back to PLATFORM_ADMIN_PASSWORD).
# PLATFORM_ADMIN_SESSION_SECRET=
# Optional per-role overrides:
# PLATFORM_ADMIN_PASSWORD_SUPER=
# PLATFORM_ADMIN_PASSWORD_BILLING=
# PLATFORM_ADMIN_PASSWORD_SUPPORT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social scheduling — real OAuth connections + publishing (all optional).
# Without Supabase configured above, the Social module falls back to a
# clearly-labeled simulated connect flow for demos only — it cannot post
# anywhere real. With Supabase configured, apply migration 006_social.sql,
# then set the secret below and any platform credentials you want live:

# Required for ANY real platform connection/publishing once Supabase is set up.
# Any long random string — used to encrypt stored access/refresh tokens at rest.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Shared secret an external scheduler must send to /api/social/cron/publish
# (as ?secret=... or an X-Cron-Secret header) every few minutes so posts with
# status "scheduled" actually go out at their scheduled time.
# Required in production (or set CRON_SECRET). Without a secret, cron routes 401.
SOCIAL_CRON_SECRET=
# Optional: due posts processed per cron hit (default 1). Keep low — Instagram polling can take 30s+.
SOCIAL_CRON_BATCH_SIZE=1
# Required on Vercel: Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Production cron routes 401 if CRON_SECRET / SOCIAL_CRON_SECRET / AUTOMATION_CRON_SECRET are all unset.
CRON_SECRET=

# Facebook Pages — Meta for Developers app with "Facebook Login for Business"
# + "Pages API" products added. Register this exact OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/social/oauth/callback/facebook
META_APP_ID=
META_APP_SECRET=

# Instagram — same Meta app, add the "Instagram" product > "API setup with
# Instagram login" (no Facebook Page required). Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/social/oauth/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn — LinkedIn Developer app with "Sign In with LinkedIn using OpenID
# Connect" + "Share on LinkedIn" products verified. Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/social/oauth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) — X Developer app with OAuth 2.0 enabled (Web App / Automated
# App type). Posting requires a paid X API tier (Basic or higher) — the free
# tier is read-only. Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/social/oauth/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=

# Namecheap (Branding → Website domain). Buys a domain and writes the website
# A and www records. Whitelist this server's outbound IP in the Namecheap API
# settings and put that same address in NAMECHEAP_CLIENT_IP.
# NAMECHEAP_SANDBOX=1 uses the sandbox endpoint and sandbox credentials.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
# NAMECHEAP_SANDBOX=

# Custom website domains (Website → Domain). DNS is checked live against these
# targets. HTTPS is probed on port 443 — it is not assumed from a CNAME match.
# Optional: attach verified hostnames to the Vercel project so certificates issue.
WEBSITE_CNAME_TARGET=sites.0nestate.app
NEXT_PUBLIC_WEBSITE_CNAME_TARGET=sites.0nestate.app
WEBSITE_APEX_IPS=76.76.21.21,76.76.21.22
NEXT_PUBLIC_WEBSITE_APEX_IP=76.76.21.21
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Required when the Vercel project lives under a team, not a personal account.
VERCEL_TEAM_ID=
